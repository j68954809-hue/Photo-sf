/* =========================
   EXAM ENGINE
========================= */

let currentIndex = 0;
let score = 0;
let answered = false;
let userAnswers = [];
let shuffledQuestions = [];

function startExam(){
  currentIndex=0;
  score=0;
  answered=false;
  userAnswers=[];
  shuffledQuestions=[...questions];

  document.getElementById("startScreen").style.display="none";
  document.getElementById("resultScreen").style.display="none";
  document.getElementById("examScreen").style.display="block";

  renderQuestion();
}

function renderQuestion(){
  const q=shuffledQuestions[currentIndex];
  answered=false;

  document.getElementById("currentStat").textContent=
    (currentIndex+1)+" / "+shuffledQuestions.length;

  document.getElementById("scoreStat").textContent=score;

  document.getElementById("percentStat").textContent=
    Math.round((currentIndex/shuffledQuestions.length)*100)+"%";

  document.getElementById("progressBar").style.width=
    (currentIndex/shuffledQuestions.length*100)+"%";

  document.getElementById("partLabel").textContent=q.part;
  document.getElementById("questionLabel").textContent="Question "+q.n;
  document.getElementById("questionText").textContent=q.q;

  const area=document.getElementById("answerArea");
  area.innerHTML="";

  if(q.type==="mcq" || q.type==="tf" || q.type==="match"){
    q.o.forEach((option,index)=>{
      const label=document.createElement("label");
      label.className="option";
      label.innerHTML=
        `<input type="radio" name="answer" value="${index}">
         <span>${escapeHTML(option)}</span>`;
      area.appendChild(label);
    });
  }else{
    const input=document.createElement("textarea");
    input.id="writtenAnswer";
    input.className="question-input";
    input.rows=4;
    input.placeholder="Enter your answer here...";
    area.appendChild(input);
  }

  const feedback=document.getElementById("feedback");
  feedback.className="feedback";
  feedback.innerHTML="";

  document.getElementById("submitBtn").disabled=false;
  document.getElementById("nextBtn").disabled=true;
  document.getElementById("nextBtn").textContent=
    currentIndex===shuffledQuestions.length-1
    ?"Finish Examination"
    :"Next Question →";
}

function escapeHTML(value){
  return String(value).replace(/[&<>"']/g,function(ch){
    return {
      "&":"&amp;",
      "<":"&lt;",
      ">":"&gt;",
      '"':"&quot;",
      "'":"&#039;"
    }[ch];
  });
}

function normalize(value){
  return String(value)
    .toLowerCase()
    .replace(/,/g,"")
    .replace(/[;:()[\]{}]/g," ")
    .replace(/\s+/g," ")
    .trim();
}

function checkWrittenAnswer(input,answers){
  const user=normalize(input);

  if(!user)return false;

  return answers.every(answer=>{
    const expected=normalize(answer);
    return user.includes(expected);
  });
}

function submitAnswer(){
  if(answered)return;

  const q=shuffledQuestions[currentIndex];
  let correct=false;
  let userAnswer="";

  if(q.type==="mcq" || q.type==="tf" || q.type==="match"){
    const selected=document.querySelector('input[name="answer"]:checked');

    if(!selected){
      alert("Please select an answer first.");
      return;
    }

    const selectedIndex=Number(selected.value);
    userAnswer=q.o[selectedIndex];
    correct=selectedIndex===q.a;

    document.querySelectorAll(".option").forEach((option,index)=>{
      option.classList.add("disabled");
      const radio=option.querySelector("input");
      radio.disabled=true;

      if(index===q.a){
        option.classList.add("correct");
      }else if(index===selectedIndex && !correct){
        option.classList.add("wrong");
      }
    });

  }else{
    const input=document.getElementById("writtenAnswer");
    userAnswer=input.value.trim();

    if(!userAnswer){
      alert("Please enter your answer first.");
      return;
    }

    correct=checkWrittenAnswer(userAnswer,q.a);
    input.disabled=true;
  }

  answered=true;

  if(correct)score++;

  userAnswers.push({
    number:q.n,
    question:q.q,
    answer:userAnswer,
    correct:correct,
    explanation:q.e,
    expected:q.a
  });

  const feedback=document.getElementById("feedback");
  feedback.className="feedback "+(correct?"correct":"wrong");

  const expectedText=Array.isArray(q.a)
    ?q.a.join(" / ")
    :q.o[q.a];

  feedback.innerHTML=correct
    ?`<strong>✓ Correct Answer!</strong>
       Excellent work.`
    :`<strong>✗ Incorrect Answer</strong>
       <b>Correct answer:</b> ${escapeHTML(expectedText)}
       <div class="explanation">
       <b>Explanation / Solution:</b><br>
       ${escapeHTML(q.e)}
       </div>`;

  document.getElementById("scoreStat").textContent=score;
  document.getElementById("submitBtn").disabled=true;
  document.getElementById("nextBtn").disabled=false;
}

function nextQuestion(){
  if(!answered)return;

  if(currentIndex<shuffledQuestions.length-1){
    currentIndex++;
    renderQuestion();
  }else{
    finishExam();
  }
}

function finishExam(){
  document.getElementById("examScreen").style.display="none";
  document.getElementById("resultScreen").style.display="block";

  const total=shuffledQuestions.length;
  const percentage=(score/total)*100;

  document.getElementById("finalScore").textContent=
    score+" / "+total;

  document.getElementById("finalMessage").textContent=
    "Your final percentage: "+percentage.toFixed(2)+"%";

  let reviewHTML="<h3>Examination Review</h3>";

  userAnswers.forEach(item=>{
    reviewHTML+=`
      <div class="review-item">
        <b>Question ${item.number}</b>
        <p>${escapeHTML(item.question)}</p>
        <p>${item.correct?"✓ Correct":"✗ Incorrect"}</p>
        ${!item.correct
          ?`<p><b>Your answer:</b> ${escapeHTML(item.answer)}</p>
            <p><b>Correct answer:</b> ${escapeHTML(item.expected.join(" / "))}</p>`
          :""}
        <p><b>Explanation:</b> ${escapeHTML(item.explanation)}</p>
      </div>`;
  });

  document.getElementById("reviewArea").innerHTML=reviewHTML;
  document.getElementById("progressBar").style.width="100%";
}

function restartExam(){
  document.getElementById("resultScreen").style.display="none";
  document.getElementById("startScreen").style.display="block";
  document.getElementById("progressBar").style.width="0%";
}
</script>

