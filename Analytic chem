    <button class="primary-btn" onclick="startExam()">Start Examination</button>
  </section>

  <section id="examScreen">
    <div class="panel">
      <div class="stats">
        <div class="stat"><strong id="currentStat">1 / 120</strong><span>Question</span></div>
        <div class="stat"><strong id="scoreStat">0</strong><span>Correct Answers</span></div>
